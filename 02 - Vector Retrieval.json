    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\n\nconst fields = response.data?.fields ?? [];\nconst values = response.data?.values ?? [];\n\nconst results = values.map(row => {\n  const item = {};\n\n  fields.forEach((field, index) => {\n    item[field] = row[index];\n  });\n\n  return item;\n});\n\nreturn [{\n  json: {\n    tool: \"vector_search\",\n    count: results.length,\n    results: results\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        0
      ],
      "id": "768c428c-74b9-4337-b523-db4535cdf81c",
      "name": "Format Vector Results"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://65123fbc.databases.neo4j.io/db/65123fbc/query/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=\n{{ JSON.stringify({\n  statement: `\n    CALL db.index.vector.queryNodes(\n      'chunk_embeddings',\n      3,\n      $embedding\n    )\n    YIELD node, score\n\n    OPTIONAL MATCH\n      (d:Document)-[:HAS_CHUNK]->(node)\n\n    OPTIONAL MATCH\n      (node)-[:ABOUT]->(k:Concept)\n\n    RETURN\n      node.id AS chunkId,\n      node.text AS content,\n      d.id AS documentId,\n      d.title AS title,\n      d.source AS source,\n      score AS similarity,\n      collect(DISTINCT k.name) AS topics\n\n    ORDER BY similarity DESC\n  `,\n  parameters: {\n    embedding: $json.data[0].embedding\n  }\n}) }}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
